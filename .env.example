# EduStream configuration template.
# Copy to .env and fill in the API keys. Never share or paste .env anywhere.
# Every value can also be set as a normal environment variable.

# --- Kafka -------------------------------------------------------------
KAFKA_HOME=C:\kafka_2.13-4.3.1
KAFKA_BOOTSTRAP=localhost:9092
EDU_RF=1
EDU_PARTITIONS=3

# --- Source / windows (see docs/ARCHITECTURE.md §6.2) -------------------
CHUNK_SECONDS=10
SPEEDUP=1
WINDOW_SECONDS=30
GRACE_SECONDS=10
ALIGN_START=true

# --- Whisper (CPU) -----------------------------------------------------
WHISPER_MODEL=base.en
WHISPER_CPU_THREADS=4

# --- Workers -----------------------------------------------------------
# Forward end-of-lecture flushes to Kafka Streams (closes each lecture's last window, A5)
FORWARD_FLUSH=true
# A5 flush timestamp: tight (default; end of the last chunk's window + GRACE) or legacy
FLUSH_FORMULA=tight

# --- Note Agent (rev 6 notebook, docs/ARCHITECTURE.md §8.1) -------------
# One notebook update per NOTE_UPDATE_S of lecture audio; a held partial update is sent after NOTE_MAX_HOLD_S.
NOTE_UPDATE_S=90
NOTE_MAX_HOLD_S=300

# --- Alerts (guards are in seconds of audio, independent of CHUNK_SECONDS) ---
T_SCORE=0.63
MIN_COVERED_S=15
LAG_ALERT_S=30

# --- LLM: free-tier APIs, tried in order, then extractive fallback ------
# Keep LLM_ENABLED=false for everyday development to save free quota.
LLM_ENABLED=false
LLM_FORCE_FAIL=false
LLM_CACHE=off
LLM_PROVIDERS=groq
# Each agent starts its model chain with a different free model, so their quotas don't collide (§8.0).
LLM_NOTES_FIRST_MODEL=openai/gpt-oss-120b
# The Note Agent's live notes use their own model, so they never share a minute's quota with consolidation.
LLM_NOTES_LIVE_MODEL=openai/gpt-oss-20b
LLM_ASSISTANT_FIRST_MODEL=openai/gpt-oss-20b
# Free-tier tokens per minute per model, and the share one Note Agent process may use of it.
LLM_TPM_LIMIT=8000
LLM_NOTES_TPM_SHARE=0.6

# Groq: free, no card (https://console.groq.com). OpenAI-compatible endpoint
# confirmed working in M2. A second free provider can be added later as
# <NAME>_BASE_URL / <NAME>_MODEL / <NAME>_API_KEY and appended to LLM_PROVIDERS.
# (Cerebras was dropped: its API requires a payment method.)
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=
GROQ_API_KEY=

# --- Optional extensions (Part B; off until the foundation works) -------
DOCTOR_ENABLED=false
VERIFIER_ENABLED=false
