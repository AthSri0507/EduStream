# EduStream configuration template.
# Copy to .env and fill in the API keys. Never share or paste .env anywhere.
# Every value can also be set as a normal environment variable.

# --- Kafka -------------------------------------------------------------
KAFKA_HOME=C:\kafka_2.13-4.3.1
KAFKA_BOOTSTRAP=localhost:9092
EDU_RF=1
EDU_PARTITIONS=3

# --- Source / windows (see docs/ARCHITECTURE.md §6.2) -------------------
CHUNK_SECONDS=5
SPEEDUP=1
WINDOW_SECONDS=30
GRACE_SECONDS=10
ALIGN_START=true

# --- Whisper (CPU) -----------------------------------------------------
WHISPER_MODEL=base.en
WHISPER_CPU_THREADS=4

# --- Alerts ------------------------------------------------------------
T_SCORE=0.55

# --- LLM: free-tier APIs, tried in order, then extractive fallback ------
# Keep LLM_ENABLED=false for everyday development to save free quota.
LLM_ENABLED=false
LLM_FORCE_FAIL=false
LLM_CACHE=off
LLM_PROVIDERS=cerebras,groq
NOTE_EVERY_N_WINDOWS=2

# Base URLs are OpenAI-compatible endpoints (to be confirmed in M2).
# Models are chosen in M2 from each provider's current free list.
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=
CEREBRAS_API_KEY=

GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=
GROQ_API_KEY=

# --- Optional extensions (Part B; off until the foundation works) -------
DOCTOR_ENABLED=false
VERIFIER_ENABLED=false
